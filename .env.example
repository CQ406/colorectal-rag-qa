# ============================================================
#  环境配置模板
#  复制为 .env 后按需修改：  Copy-Item .env.example .env
#  .env 已被 .gitignore 忽略，不会进入版本库
# ============================================================

# ---------- 应用 ----------
APP_NAME=结直肠手术围术期多模态知识库智能问答系统
APP_ENV=dev
DEBUG=true
API_PREFIX=/api
# 允许跨域的前端地址（Vite 默认 5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- PostgreSQL + pgvector ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_pwd
POSTGRES_DB=colorectal_rag

# ---------- Neo4j 知识图谱 ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_pwd

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------- MinIO 对象存储 ----------
MINIO_ENDPOINT=localhost:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minio_dev_pwd
MINIO_SECURE=false
MINIO_BUCKET_DOCS=literature
MINIO_BUCKET_IMAGES=images

# ---------- 检索模型（跑在宿主机 GPU 上） ----------
# 必须用本地目录路径，不要写 BAAI/bge-m3（会触发 .DS_Store 下载失败）
EMBEDDING_MODEL_PATH=D:\models\bge-m3
RERANKER_MODEL_PATH=D:\models\bge-reranker-v2-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
# 超过此条数才启用 GPU，否则 CPU 更省显存
EMBEDDING_MAX_LENGTH=512

# ---------- 大语言模型（答案生成） ----------
# 注册地址: https://platform.deepseek.com
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-在此填写你的DeepSeek密钥
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# ---------- 多模态大模型（影像解读） ----------
# 智谱 GLM-4V-Flash 完全免费，注册: https://bigmodel.cn
VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VLM_API_KEY=在此填写你的智谱密钥
VLM_MODEL=glm-4v-flash
VLM_TIMEOUT=120

# ---------- 检索策略 ----------
# 各路召回条数
RETRIEVE_TOP_K_VECTOR=50
RETRIEVE_TOP_K_KEYWORD=50
RETRIEVE_TOP_K_GRAPH=20
# RRF 融合常数（经验值 60）
RRF_K=60
# 重排后送入 LLM 的条数
RERANK_TOP_N=5
# 是否启用知识图谱召回
ENABLE_GRAPH_RETRIEVAL=true

# ---------- 文献采集 ----------
# PubMed E-utilities，注册邮箱可提高配额
PUBMED_EMAIL=your_email@example.com
PUBMED_API_KEY=
PUBMED_TOOL=colorectal-rag-thesis
PUBMED_MAX_RESULTS=500

# ---------- 后台任务 ----------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
