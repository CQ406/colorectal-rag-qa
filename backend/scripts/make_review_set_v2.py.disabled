    ("In Kaplan– Meier subgroup analyses, apparent DMFS differences", "低危患者接受辅助化疗与不接受的 DMFS 差异如何？作者怎么评价该发现的可靠性？", True),
]


def norm(s: str) -> str:
    return " ".join(s.split())


def main() -> int:
    pool = json.loads(POOL.read_text(encoding="utf-8"))
    by_prefix = []
    for item in pool:
        by_prefix.append((norm(item["text"]), item))

    items, unmatched, dup = [], [], []
    for prefix, question, relational in SPECS:
        p = norm(prefix)
        hits = [it for txt, it in by_prefix if txt.startswith(p)]
        if len(hits) != 1:
            (dup if hits else unmatched).append((prefix, len(hits)))
            continue
        it = hits[0]
        items.append({
            "qid": f"V2-{len(items)+1:03d}",
            "question": question,
            "gold_chunk_ids": [it["id"]],
            "source_document_title": it["title"],
            "evidence_level": it["level"],
            "language": "zh" if it["lang"].startswith("chi") else "en",
            "relational": relational,
            "from_new_document": bool(it["new_today"]),
        })

    if unmatched or dup:
        print(f"  ✗ 前缀未匹配 {len(unmatched)} 条、匹配不唯一 {len(dup)} 条，请修正后重跑")
        for x in unmatched[:10]:
            print("    未匹配:", x)
        for x in dup[:10]:
            print("    不唯一:", x)
        return 1

    from scripts.prepare_review_set import corpus_snapshot
    from app.db.session import session_scope

    with session_scope() as db:
        corpus = corpus_snapshot(db)

    doc = {
        "dataset": "review_set_v2",
        "version": "2026-11-14",
        "corpus": corpus,
        "items": items,
        "limitations": [
            "题目由开发者阅读原文后撰写，不是独立临床留出集",
            "金标准为单个文本块，未标注其他等价正确答案",
            "语料在构建前刚由 109 篇扩容到 118 篇，指纹为 118 篇快照",
            "关系型题目仅 8 条，统计效力有限",
        ],
    }
    OUT.write_text(json.dumps(doc, ensure_ascii=False, indent=2), encoding="utf-8")

    zh = sum(1 for i in items if i["language"] == "zh")
    print(f"  ✓ 已生成 {len(items)} 题 → {OUT}")
    print(f"    中文 {zh} / 英文 {len(items)-zh} | 关系型 {sum(1 for i in items if i['relational'])} | 来自新文献 {sum(1 for i in items if i['from_new_document'])}")
    print(f"    语料快照: {corpus.get('documents')} 篇 / {corpus.get('chunks')} 块")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
