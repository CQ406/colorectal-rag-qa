def main():
    specs = [('guideline', s) for s in GUIDELINE] + [('review', s) for s in REVIEW] + [('relation', s) for s in RELATION]
    assert len(specs) == 50, len(specs)
    items = []
    with session_scope() as db:
        snapshot = corpus_snapshot(db)
        for n, (group, (alias, pref, question, ref, qtype, kws)) in enumerate(specs, 1):
            rows = db.execute(text('''SELECT c.id AS cid, c.content, c.section, c.page_start, c.phase,
                    c.evidence_level, d.id AS did, d.title, d.doi
                FROM kb_chunk c JOIN kb_document d ON d.id=c.document_id
                WHERE c.id::text LIKE :p AND d.is_active'''), {'p': pref + '%'}).mappings().all()
            assert len(rows) == 1, (alias, len(rows))
            r = rows[0]
            assert r['evidence_level'] in ('guideline', 'review')
            items.append({
                'qid': f'V2-{n:02}',
                'question': question,
                'gold_chunk_id': str(r['cid']),
                'gold_document_id': str(r['did']),
                'gold_doc_title': r['title'],
                'gold_page': r['page_start'],
                'phase': r['phase'],
                'doi': r['doi'],
                'gold_span': r['content'],
                'reference_answer': ref,
                'content_sha256': hashlib.sha256(r['content'].encode()).hexdigest(),
                'review_status': 'pending_independent_clinical_review',
                'reviewer': None,
                # additive, optional fields (existing loader ignores unknown keys)
                'gold_evidence_level': r['evidence_level'],
                'question_type': qtype,
                'expected_keywords': kws,
            })

    # structural guards
    ids = [i['gold_chunk_id'] for i in items]
    assert len(set(ids)) == 50, 'duplicate gold chunks'
    per_doc = {}
    for i in items:
        per_doc[i['gold_document_id']] = per_doc.get(i['gold_document_id'], 0) + 1
    assert max(per_doc.values()) <= 3, per_doc

    data = {
        'name': 'Current-corpus source-grounded development review set',
        'version': '2026-11-14.2',
        'created_at': datetime.now(timezone.utc).isoformat(),
        'corpus': snapshot,
        'items': items,
        'limitations': ('50 source-selected development questions (25 guideline-level, 25 review-level; 10 of them relational); '
                        'single-positive labels; questions author-written after reading the gold chunks, not independently '
                        'held out from clinical practice; no expert approval or clinical accuracy claim.'),
    }
    target = PROJECT_ROOT / 'data/eval/review_set_v2.json'
    target.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding='utf-8')

    from collections import Counter
    dist = {
        'evidence': Counter(i['gold_evidence_level'] for i in items),
        'phase': Counter(i['phase'] for i in items),
        'type': Counter(i['question_type'] for i in items),
        'docs': len(per_doc),
        'corpus': snapshot,
    }
    print(json.dumps(dist, ensure_ascii=False, default=dict))
    print('written', target)


if __name__ == '__main__':
    main()
